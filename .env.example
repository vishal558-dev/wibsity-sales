# Supabase project settings (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Credentials for the one seeded operator account (db/seed.ts creates this user).
SEED_OPERATOR_EMAIL=
SEED_OPERATOR_PASSWORD=

# Forces the Inngest SDK into dev mode (no signing key needed) for local runs.
INNGEST_DEV=1

# Inngest (background jobs). Not needed for local dev (INNGEST_DEV=1 above
# covers it) — required in production.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Business-search provider for lead generation ("mock" or "serpapi").
BUSINESS_SEARCH_PROVIDER=mock
SERPAPI_API_KEY=

# AI interpreter for website audits (Phase 4). Only "mock" is implemented —
# it's a template-based dev/test-only interpreter, not a real LLM call. A
# real provider (Anthropic/OpenAI) can be added later behind the same
# providers/ai-interpreter/index.ts factory.
AI_INTERPRETER_PROVIDER=mock
