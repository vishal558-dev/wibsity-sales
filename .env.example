# Supabase project settings (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Credentials for the one seeded operator account (db/seed.ts creates this user).
SEED_OPERATOR_EMAIL=
SEED_OPERATOR_PASSWORD=

# Forces the Inngest SDK into dev mode (no signing key needed) for local runs.
INNGEST_DEV=1

# Inngest (background jobs). Not needed for local dev (INNGEST_DEV=1 above
# covers it) — required in production.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Business-search provider for lead generation (Phase 3). Only "mock" is
# implemented — it's a dev/test-only data generator, not a real integration.
# A real provider (e.g. Google Places) can be added later behind the same
# providers/business-search/index.ts factory.
BUSINESS_SEARCH_PROVIDER=mock
